# Configuración única para local y producción/cPanel
DJANGO_SETTINGS_MODULE=config.settings

# Seguridad
SECRET_KEY=change-me-with-a-long-random-value
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,testserver
CSRF_TRUSTED_ORIGINS=

# PostgreSQL: opción 1 (recomendada)
DATABASE_URL=postgresql://aulapro:change-me@localhost:5432/aulapro

# PostgreSQL: opción 2 (útil en cPanel). Si usa DATABASE_URL puede dejar estas vacías.
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
DB_SSLMODE=
DB_CONN_MAX_AGE=0

# HTTPS / producción
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
USE_X_FORWARDED_PROTO=False
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False
