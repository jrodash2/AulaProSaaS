DJANGO_SETTINGS_MODULE=config.settings
APP_VERSION=dev

# Seguridad (genere una clave real; nunca la confirme en Git)
DEBUG=True
SECRET_KEY=
ALLOWED_HOSTS=localhost,127.0.0.1,testserver
CSRF_TRUSTED_ORIGINS=
LOG_LEVEL=WARNING

# PostgreSQL: opción recomendada
DATABASE_URL=

# PostgreSQL: variables separadas (alternativa a DATABASE_URL)
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
DB_SSLMODE=
DB_CONN_MAX_AGE=0

# HTTPS. En producción se recomiendan los valores indicados entre comentarios.
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
USE_X_FORWARDED_PROTO=False
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False
SECURE_REFERRER_POLICY=same-origin
SECURE_CROSS_ORIGIN_OPENER_POLICY=same-origin
